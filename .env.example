# ---- GREEN-API (WhatsApp) ----
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Base host for your instance's API calls, e.g. https://7105.api.greenapi.com
GREEN_API_BASE_URL=https://api.greenapi.com

# Comma separated list of WhatsApp group chatIds to watch, e.g. 120363012345678901@g.us
# Optionally give each one a friendly label with :label, e.g.
# 120363012345678901@g.us:VIP Customers,120363019876543210@g.us:Support Group
GREEN_API_WATCHED_GROUPS=

# How often (minutes) to poll each watched group's member list to catch
# members who joined silently (see README - GREEN-API has no native "joined" webhook)
GROUP_POLL_INTERVAL_MINUTES=10

# Optional shared secret. If set, incoming webhooks must include it as
# ?token=<value> in the webhook URL configured in the GREEN-API console.
WEBHOOK_SHARED_SECRET=

PORT=3000

# Every outbound call to GREEN-API/Peach aborts after this long instead of
# hanging forever if the other side is slow/unreachable.
HTTP_TIMEOUT_MS=20000

# Where groups-state.json (which members we've already seen per group) is
# stored. On Railway, mount a Volume and point this at its mount path so
# state survives redeploys - otherwise it's lost on every restart.
DATA_DIR=/app/data

# ---- Peach CRM ----
PEACH_API_BASE_URL=https://api.peach-in.com/v4
PEACH_API_KEY=

# Header scheme used to send PEACH_API_KEY: "Authorization: <scheme> <key>".
# Docs don't spell out the scheme explicitly; leave as Bearer and switch to
# an empty string (raw key, no prefix) if requests come back unauthorized.
PEACH_AUTH_SCHEME=Bearer

# How WhatsApp-group membership is written to the contact:
# "nativeGroups"   - Peach's built-in contact `groups` array (recommended;
#                     additive, no read-then-merge race condition).
# "customProperty" - store a joined list inside one customProperties field
#                     instead. Set PEACH_WHATSAPP_GROUPS_FIELD to that
#                     field's key (create it in the Peach admin UI first).
PEACH_GROUP_SYNC_MODE=nativeGroups
PEACH_WHATSAPP_GROUPS_FIELD=whatsapp_groups

# Phone format written to Peach: "e164" (+972501234567) or "local-il" (0501234567)
PEACH_PHONE_FORMAT=e164

# create-contact requires firstName/lastName/email. WhatsApp only reliably
# gives us a phone number, so these fill the gap for contacts we create
# without a name. Set PEACH_PLACEHOLDER_EMAIL_DOMAIN="" to omit email
# instead (only do this once you've confirmed email isn't actually required).
PEACH_DEFAULT_FIRST_NAME=WhatsApp
PEACH_DEFAULT_LAST_NAME_PREFIX=Contact
PEACH_PLACEHOLDER_EMAIL_DOMAIN=whatsapp.invalid
