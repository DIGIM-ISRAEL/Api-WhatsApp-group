# ---- GREEN-API (WhatsApp) ----
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Base host for your instance's API calls, e.g. https://7105.api.greenapi.com
GREEN_API_BASE_URL=https://api.greenapi.com

# Comma separated list of WhatsApp group chatIds to watch, e.g. 120363012345678901@g.us
# Optionally give each one a friendly label with :label, e.g.
# 120363012345678901@g.us:VIP Customers,120363019876543210@g.us:Support Group
GREEN_API_WATCHED_GROUPS=

# How often (minutes) to poll each watched group's member list to catch
# members who joined silently (see README - GREEN-API has no native "joined" webhook)
GROUP_POLL_INTERVAL_MINUTES=10

# Optional shared secret. If set, incoming webhooks must include it as
# ?token=<value> in the webhook URL configured in the GREEN-API console.
WEBHOOK_SHARED_SECRET=

PORT=3000

# ---- Peach CRM ----
PEACH_API_BASE_URL=
PEACH_API_KEY=

# The customProperties key in Peach used to store which WhatsApp group(s)
# a contact belongs to. Create this custom field in Peach first.
PEACH_WHATSAPP_GROUPS_FIELD=whatsapp_groups

# Query param name used by GET /contacts to search by phone number.
# Confirm the exact name against the Peach docs; "telephone" matches the
# field name used in the Peach contact object.
PEACH_PHONE_QUERY_PARAM=telephone

# Phone format written to Peach: "e164" (+972501234567) or "local-il" (0501234567)
PEACH_PHONE_FORMAT=e164
